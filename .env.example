# Copy to .env and fill in. Never commit .env.

# --- Core ---
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# --- Database ---
# Railway's Postgres plugin provides this. Locally, leave it unset to run an
# embedded Postgres (PGlite) with no install: pglite://./.data/medbot
DATABASE_URL=

# --- Demo / exploration ---
# true  -> exposes /auth/demo and the reset controls, seeds mock data on first
#          sign-in, and shows the "Enter demo" button on the home page.
# false -> those routes do not exist at all. Set this once you start using it
#          for real, after running the master reset from Settings.
# In production (NODE_ENV=production) demo is OFF unless explicitly true.
DEMO_MODE=true

# --- Secrets ---
# openssl rand -hex 32
SESSION_SECRET=
# openssl rand -hex 32  -- used for at-rest encryption of sensitive columns
ENCRYPTION_KEY=

# --- Admin ---
# The operator's Google email. On login this account becomes the 'owner', which
# unlocks the admin section and the ability to grant admin to other users.
OWNER_EMAIL=

# One-time bootstrap for admin password login. Used only when no admin/owner
# account has a password yet. Sign in at /admin/login, then change the password.
# Remove or leave unset after the first login — the hash lives in the database.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Redis (Railway Redis plugin provides this) ---
REDIS_URL=redis://localhost:6379

# --- Google OAuth ---
# console.cloud.google.com -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# --- OpenRouter (optional server-wide fallbacks) ---
# Users can configure their own key, base URL, and models in Settings → AI & OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model routing by task class. Used when a user has not set their own preference.
MODEL_CHAT=anthropic/claude-sonnet-4.5
MODEL_EXTRACT=anthropic/claude-haiku-4.5
MODEL_ANALYZE=anthropic/claude-sonnet-4.5
# Multimodal model for reading uploaded lab reports / prescriptions / scans.
# Must accept images and PDFs.
MODEL_VISION=anthropic/claude-sonnet-4.5

# Assistant voice (OpenRouter audio APIs — same key as chat).
MODEL_TTS=openai/gpt-4o-mini-tts
MODEL_STT=openai/whisper-large-v3
TTS_VOICE=alloy
